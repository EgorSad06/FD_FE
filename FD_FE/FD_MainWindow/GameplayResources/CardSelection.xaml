<Page x:Class="FD_MainWindow.CardSelection"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FD_MainWindow"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="CardSelection">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/ProgramData;component/Assets/Sprites/Menu/backgroundstar.png" Stretch="UniformToFill"/>
        </Grid.Background>
        <Border Width="1230" Height="318" BorderBrush="White" BorderThickness="2" CornerRadius="10">
            <Grid x:Name="CardSelectionGrid" Width="1200" Height="288">

            </Grid>
        </Border>
        <Button Content="Готово" Style="{StaticResource S_std_but}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24" Click="Start_Click"/>
    </Grid>
</Page>