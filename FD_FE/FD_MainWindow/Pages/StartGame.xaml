<Page x:Class="FD_MainWindow.Pages.StartGame"
      x:Name="Start_game"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FD_MainWindow.Pages"
      mc:Ignorable="d" 
      d:DesignWidth="1600" d:DesignHeight="900"
      Title="StartGame">
    <Page.Background>
        <ImageBrush ImageSource="/ProgramData;component/Assets/Sprites/Menu/backgroundstar.png" Stretch="UniformToFill"/>
    </Page.Background>
    <Page.Resources>
        <Style x:Key="S_frct_but" TargetType="Button">
            <Setter Property="Width" Value="316"/>
            <Setter Property="Height" Value="496"/>
            <Setter Property="Margin" Value="16,0,16,0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="8"/>
            <Setter Property="Template" Value="{StaticResource T_card_but}"/>
        </Style>
        <Style x:Key="S_sc_rbut" TargetType="RadioButton" BasedOn="{StaticResource S_std_rbut}">
            <Setter Property="Width" Value="160"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="36"/>
        </Style>
    </Page.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>
        <Viewbox MaxWidth="1080">
            <Border Width="1080" Height="540" BorderBrush="White" BorderThickness="4" CornerRadius="30">
                <StackPanel x:Name="SP_modes" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                </StackPanel>
            </Border>
        </Viewbox>

        <!--Grid Width="440" Height="144" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="24" Grid.ColumnSpan="2">
            <TextBox x:Name="Message" Width="440" Height="80" HorizontalAlignment="Center" VerticalAlignment="Top" Style="{StaticResource S_std_tbox}"/>
            <Button x:Name="B_send" Content="Отправить" HorizontalAlignment="Left" VerticalAlignment="Bottom" Style="{StaticResource S_std_but}" IsEnabled="False" Click="Send_Click"/>
            <Button x:Name="B_receive" Content="Получить" HorizontalAlignment="Right" VerticalAlignment="Bottom" Style="{StaticResource S_std_but}" IsEnabled="False" Click="Receive_Click"/>
        </Grid-->
        
        <Viewbox MaxWidth="230" Grid.Column="1" Margin="0,64,0,64">
            <StackPanel Width="230" Height="400" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="1">
                <TextBlock Text="Подключение" Width="230" Height="64" FontWeight="Bold" Foreground="White" FontSize="36" Style="{StaticResource S_std_tblk}"/>
                <RadioButton Content="Клиент" IsChecked="True" Style="{StaticResource S_sc_rbut}"/>
                <RadioButton x:Name="RB_server" Content="Сервер" Style="{StaticResource S_sc_rbut}"/>
                <TextBox x:Name="TB_IP" Width="180" Height="50" Margin="10" Style="{StaticResource S_std_tbox}" ToolTip="IP-адрес"/>
                <Button x:Name="B_connect" Content="Подключиться" Style="{StaticResource S_std_but}" Width="210" Margin="1" Click="Connect_Click"/>

                <Button Content="DB_serv" Tag="t" Style="{StaticResource S_std_but}" Margin="8" Click="DB_Click"/>
                <Button Content="DB_clnt" Tag="f" Style="{StaticResource S_std_but}" Click="DB_Click"/>
            </StackPanel>
        </Viewbox>

        <Button x:Name="B_start" Content="Начать"  Style="{StaticResource S_std_but}" Margin="24" HorizontalAlignment="Right" VerticalAlignment="Bottom"  IsEnabled="False" Click="StartButton_Click" Grid.Column="1"/>
        <Button Content="Выход" Style="{StaticResource S_std_but}" Margin="24" HorizontalAlignment="Left" VerticalAlignment="Bottom" Click="Exit_Click"/>

    </Grid>
</Page>
