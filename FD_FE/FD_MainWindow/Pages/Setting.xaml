<Page x:Class="FD_MainWindow.Setting"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FD_MainWindow"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Setting"
      Background="DarkBlue">
    <Page.Resources>
        <Style TargetType="Button" x:Key="S_but" BasedOn="{StaticResource S_std_but}">
            <Setter Property="Margin" Value="10"/>
        </Style>
    </Page.Resources>
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/ProgramData;component/Assets/Sprites/Menu/backgroundstar.png" Stretch="UniformToFill"/>
        </Grid.Background>

        <StackPanel Orientation="Vertical" Margin="0,53,0,29">
            <!-- Настройка разрешения -->

            <!-- Режим окна -->
            <GroupBox Header="Режим отображения" FontSize="20" Foreground="White"  Margin="0 0 0 10" Width="682">
                <StackPanel>
                    <RadioButton x:Name="WindowedRadioButton" 
                   Content="Оконный режим" 
                   IsChecked="True"
                                 Foreground="White"/>
                    <RadioButton x:Name="FullScreenRadioButton" 
                   Content="Полный экран"
                                 Foreground="White"/>
                </StackPanel>
            </GroupBox>

            <!-- Настройки звука -->
            <GroupBox Header="Настройки звука" Foreground="White" FontSize="20" RenderTransformOrigin="0.5,0.5" Width="686">
                <StackPanel>
                    <Label Content="Громкость музыки:" Foreground="White"/>
                    <Slider Value="{Binding MasterVolume, Mode=TwoWay}" 
                          Minimum="0" Maximum="100" Width="672"/>

                    <Label Content="Громкость эффектов:" Foreground="White"/>
                    <Slider Value="{Binding EffectsVolume,  Mode=TwoWay}" 
                          Minimum="0" Maximum="100" Width="672"/>
                </StackPanel>
            </GroupBox>

            <!-- Кнопки управления -->
            <StackPanel Orientation="Horizontal"  HorizontalAlignment="Center" Margin="0 20">
                <Button Content="Применить" Style="{StaticResource S_but}" Click="ApplyButton_Click"/>
                <Button Content="Сбросить" Style="{StaticResource S_but}" Click="ResetButton_Click"/>
                <Button Content="Назад" Style="{StaticResource S_but}" Background="LightGray" Click="BackButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
