<Page x:Class="FD_MainWindow.Pages.Setting"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FD_MainWindow.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Setting">
    <Page.Background>
        <ImageBrush ImageSource="/ProgramData;component/Assets/Sprites/Menu/backgroundstar.png" Stretch="UniformToFill"/>
    </Page.Background>
    <Page.Resources>
        <Style TargetType="Button" x:Key="S_but" BasedOn="{StaticResource S_std_but}">
            <Setter Property="Margin" Value="10"/>
        </Style>
    </Page.Resources>
    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
        <!-- Настройка разрешения -->

        <!-- Режим окна -->
        <GroupBox Foreground="White" Width="640" Margin="8">
            <GroupBox.Header>
                <TextBlock Text="Режим отображения" Style="{StaticResource S_std_tblk}"/>
            </GroupBox.Header>
            <StackPanel Margin="8">
                <RadioButton x:Name="WindowedRadioButton" Content="Оконный режим" 
                                Style="{StaticResource S_std_rbut}" Width="200"
                                IsChecked="True"/>
                <RadioButton x:Name="FullScreenRadioButton" Content="Полный экран"
                                Style="{StaticResource S_std_rbut}" Width="200"/>
            </StackPanel>
        </GroupBox>

        <!-- Настройки звука -->
        <GroupBox Foreground="White" Width="640" Margin="8">
            <GroupBox.Header>
                <TextBlock Text="Настройки звука" Style="{StaticResource S_std_tblk}"/>
            </GroupBox.Header>
            <StackPanel Margin="8">
                <TextBlock Text="Громкость музыки:" Style="{StaticResource S_std_tblk}"/>
                <Slider Value="{Binding MasterVolume, Mode=TwoWay}"
                        Minimum="0" Maximum="100" Width="600"/>

                <TextBlock Text="Громкость эффектов:" Style="{StaticResource S_std_tblk}"/>
                <Slider Value="{Binding EffectsVolume,  Mode=TwoWay}"
                        Minimum="0" Maximum="100" Width="600"/>
            </StackPanel>
        </GroupBox>

        <!-- Кнопки управления -->
        <StackPanel Orientation="Horizontal"  HorizontalAlignment="Center" Margin="8">
            <Button Content="Применить" Style="{StaticResource S_but}" Click="ApplyButton_Click"/>
            <Button Content="Сбросить" Style="{StaticResource S_but}" Click="ResetButton_Click"/>
            <Button Content="Назад" Style="{StaticResource S_but}" Click="BackButton_Click"/>
        </StackPanel>
    </StackPanel>
</Page>
