<Page x:Class="FD_MainWindow.Pages.Statistic"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FD_MainWindow.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Statistic"
      Loaded="Page_Loaded">
    
    <Page.Resources>
        <Style x:Key="S_tbl_tblk" TargetType="TextBlock" BasedOn="{StaticResource S_std_tblk}">
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
    </Page.Resources>
    
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/ProgramData;component/Assets/Sprites/Menu/backgroundstar.png" Stretch="UniformToFill"/>
        </Grid.Background>

        <StackPanel Width="640" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
            <GroupBox>
                <GroupBox.Header>
                    <TextBlock Text="Игровая статистика" Style="{StaticResource S_tbl_tblk}" FontWeight="Bold"/>
                </GroupBox.Header>
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Наигранно времени: " Style="{StaticResource S_tbl_tblk}"
                               Grid.Row="0" Grid.Column="0" />
                    <TextBlock x:Name="TotalTimeText" Text="00:00:00" Style="{StaticResource S_tbl_tblk}"
                               Grid.Row="0" Grid.Column="1"/>

                    <TextBlock Text="Игр сыгрнанно:" Style="{StaticResource S_tbl_tblk}"
                               Grid.Row="1" Grid.Column="0"/>
                    <TextBlock x:Name="GamesPlayedText" Text="0" Style="{StaticResource S_tbl_tblk}"
                               Grid.Row="1" Grid.Column="1"/>

                    <TextBlock Text="Побед:" Style="{StaticResource S_tbl_tblk}"
                               Grid.Row="2" Grid.Column="0"/>
                    <TextBlock x:Name="WinsText" Text="0" Style="{StaticResource S_tbl_tblk}"
                               Grid.Row="2" Grid.Column="1"/>

                    <TextBlock Text="Поражений:" Style="{StaticResource S_tbl_tblk}"
                               Grid.Row="3" Grid.Column="0"/>
                    <TextBlock x:Name="LossesText" Text="0" Style="{StaticResource S_tbl_tblk}"
                               Grid.Row="3" Grid.Column="1"/>

                    <TextBlock Text="Убито противников:" Style="{StaticResource S_tbl_tblk}"
                               Grid.Row="4" Grid.Column="0"/>
                    <TextBlock x:Name="EnemiesKilledText" Text="0" Style="{StaticResource S_tbl_tblk}"
                               Grid.Row="4" Grid.Column="1"/>
                </Grid>
            </GroupBox>

            <Button Content="Назад" Style="{StaticResource S_std_but}"
                    Margin="24"
                    Click="BackButton_Click"/>
        </StackPanel>
    </Grid>
</Page>