<Page x:Class="FD_MainWindow.Pages.Battle"
      x:Name="BattlePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FD_MainWindow.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1920"
      Title="Battle">
    <Page.Background>
        <ImageBrush ImageSource="/ProgramData;component/Assets/Sprites/Menu/backgroundstar.png" Stretch="UniformToFill"/>
    </Page.Background>
    <Page.Resources>
        <Style x:Key="S_but" BasedOn="{StaticResource S_std_but}" TargetType="Button">
            <Setter Property="Width" Value="200"/>
            <Setter Property="Height" Value="120"/>
            <Setter Property="FontSize" Value="40"/>
        </Style>
        <Style x:Key="S_stat_tblk" TargetType="TextBlock" BasedOn="{StaticResource S_std_tblk}">
            <Setter Property="Text" Value="0"/>
            <Setter Property="Width" Value="80"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="DarkBlue"/>
            <Setter Property="FontSize" Value="80"/>
            <Setter Property="Grid.Column" Value="1"/>
        </Style>
    </Page.Resources>
    <Viewbox>
        <Grid Height="1080">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="1280" />
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="240"/>
            </Grid.ColumnDefinitions>
            <Border BorderBrush="DimGray" BorderThickness="2" Grid.Column="0">
                <Border.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="#FF6F6F6F"/>
                        <GradientStop Color="#FFB7B7B7" Offset="0.323"/>
                        <GradientStop Color="#FF3E3E3E" Offset="1"/>
                        <GradientStop Color="#FFD8D8D8" Offset="0.68"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <TextBlock x:Name="TB_o_score" Style="{StaticResource S_stat_tblk}" Margin="0,0,0,350" Grid.Column="0"/>
            <TextBlock x:Name="TB_turns" Style="{StaticResource S_stat_tblk}" Foreground="Black" FontWeight="Black" FontSize="100" Grid.Column="0"/>
            <TextBlock x:Name="TB_p_score" Style="{StaticResource S_stat_tblk}" Margin="0,0,0,-350" Grid.Column="0"/>

            <Border x:Name="MainBoardBorder" Width="1200" Height="1000" BorderBrush="White" BorderThickness="4" CornerRadius="20" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="1">
                <Border.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="Black" Offset="0.509"/>
                        <GradientStop Color="#FF140A23" Offset="1"/>
                        <GradientStop Color="#FF220A23" Offset="0.004"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid x:Name="MainBoardGrid" Width="1160" Height="960" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <Border x:Name="HandBoardBorder" Width="240" Height="1000" BorderBrush="White" BorderThickness="4" CornerRadius="10" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="2">
                <Border.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="Black"/>
                        <GradientStop Color="#FF091B51" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid x:Name="HandBoardGrid" Width="200" Height="784" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <Border BorderBrush="DimGray" BorderThickness="2" Grid.Column="3">
                <Border.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="#FF6F6F6F"/>
                        <GradientStop Color="#FFB7B7B7" Offset="0.323"/>
                        <GradientStop Color="#FF3E3E3E" Offset="1"/>
                        <GradientStop Color="#FFD8D8D8" Offset="0.68"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Button Content="Сбросить" VerticalAlignment="Bottom" Margin="0,0,0,200" Grid.Column="3" Click="Clear_Click" Style="{StaticResource S_but}"/>
            <Button x:Name="B_ready" Content="Готово" VerticalAlignment="Bottom" Margin="0,0,0,40" Grid.Column="3" Click="Ready_Click" Style="{StaticResource S_but}"/>
            <TextBlock x:Name="State" Text="Состояние" Height="80" VerticalAlignment="Top" Margin="0,80,0,0" Style="{StaticResource S_std_tblk}" Foreground="Black" Background="WhiteSmoke" FontSize="36" TextAlignment="Center" Grid.Column="3"/>
        </Grid>
    </Viewbox>
</Page>
